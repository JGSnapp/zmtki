{
  "name": "@zmtki/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "dist": "electron-builder --dir"
  },
  "dependencies": {
    "@zmtki/board-schema": "workspace:*",
    "@zmtki/core": "workspace:*",
    "@zmtki/protocol": "workspace:*",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "@xyflow/react": "^12.3.6",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "mermaid": "^11.4.1",
    "monaco-editor": "^0.52.2",
    "perfect-freehand": "^1.2.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "zustand": "^5.0.2"
  },
  "build": {
    "appId": "dev.zmtki.artifactboard",
    "productName": "Artifact Board",
    "directories": {
      "output": "release"
    },
    "files": ["out/**/*", "resources/**/*"],
    "win": {
      "target": "nsis"
    }
  }
}
